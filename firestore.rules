rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /admins/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow write: if false;
    }

    match /Wishes/{wishId} {
      allow read: if true;

      allow create, update, delete: if isAdmin();
    }

    match /Reactions/{reactionId} {

      allow create: if
        request.resource.data.keys().hasAll([
          'name', 'emoji', 'person', 'wishId', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'emoji', 'person', 'wishId', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.emoji in [
          '❤️', '🙏', '😍', '🥳', '😎', '😂'
        ]
        && request.resource.data.person is string
        && request.resource.data.person.size() <= 80
        && request.resource.data.wishId is string
        && request.resource.data.wishId.size() <= 80
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin();

      allow update, delete: if false;
    }

    match /Visits/{visitId} {

      allow create: if
        request.resource.data.keys().hasAll([
          'person', 'wishId', 'title',
          'seconds', 'completed', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'person', 'wishId', 'title',
          'seconds', 'completed', 'updatedAt'
        ])
        && request.resource.data.person is string
        && request.resource.data.person.size() <= 80
        && request.resource.data.wishId is string
        && request.resource.data.wishId.size() <= 80
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.seconds is number
        && request.resource.data.seconds >= 0
        && request.resource.data.seconds <= 86400
        && request.resource.data.completed is bool
        && request.resource.data.updatedAt == request.time;

      allow read, delete: if isAdmin();

      allow update: if false;
    }

    match /CustomFestivals/{festivalId} {
      allow read: if true;

      allow create, update, delete: if isAdmin();
    }
  }
}
